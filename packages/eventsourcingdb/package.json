{
  "name": "@nimbus-cqrs/eventsourcingdb",
  "version": "2.5.0",
  "description": "Simplify Event-Driven Applications - EventSourcingDB integration for the Nimbus framework.",
  "keywords": [
    "nimbus",
    "cqrs",
    "event-sourcing",
    "event-driven",
    "typescript",
    "eventsourcingdb",
    "database",
    "event-store",
    "event-stream"
  ],
  "license": "Apache-2.0",
  "author": "Daniel Gördes <d.goerdes@overlap.at> (https://overlap.at)",
  "homepage": "https://nimbus.overlap.at",
  "repository": {
    "type": "git",
    "url": "https://github.com/overlap-dev/Nimbus",
    "directory": "packages/eventsourcingdb"
  },
  "bugs": {
    "url": "https://github.com/overlap-dev/Nimbus/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.metrics_worker.ts"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test --test-force-exit"
  },
  "dependencies": {
    "@nimbus-cqrs/core": "workspace:^",
    "@opentelemetry/api": "catalog:",
    "ulid": "catalog:"
  },
  "peerDependencies": {
    "eventsourcingdb": "^2.0.0"
  },
  "devDependencies": {
    "@opentelemetry/sdk-metrics": "catalog:",
    "@types/node": "catalog:",
    "eventsourcingdb": "catalog:",
    "typescript": "catalog:"
  }
}
