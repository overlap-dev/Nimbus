# ! Sensitive data should not be added here use dedicated secret stores instead.

NODE_ENV=development
LOG_LEVEL=debug
LOG_FORMAT=pretty

HTTP_PORT=3200

MONGO_DB=nimbus-esdm-full-example
MONGO_URL=mongodb://localhost:27017

ESDB_URL=http://localhost:3000
ESDB_API_TOKEN=secret

# Base URL of the (not included) frontend; used in the assignee mail link.
APP_ORIGIN=http://localhost:3200

# notify-assignee sends via SMTP. Mailpit needs no login:
# set SMTP_USER and SMTP_PASSWORD to _NONE_.
# Set both when the server requires auth.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=_NONE_
SMTP_PASSWORD=_NONE_
SMTP_FROM=tickets@example.com
